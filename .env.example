PUBLIC_BASE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Kakao OAuth
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback

# Bizgo
BIZGO_API_KEY=your_bizgo_api_key
BIZGO_SENDER_KEY=your_bizgo_sender_key

# Document PII
DOCUMENT_PII_SECRET=replace_with_a_long_random_secret

# Google Drive PDF Export
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
# Use one of the following service account key settings.
GOOGLE_SERVICE_ACCOUNT_KEY_JSON_BASE64=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Optional: required when using Google Workspace domain-wide delegation.
GOOGLE_DRIVE_IMPERSONATED_USER_EMAIL=

# Optional: override hard-coded fallback master id
MASTER_KAKAO_ID=1234567890
